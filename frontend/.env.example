# Backend base URL. Leave empty in dev (Vite proxies /api to http://127.0.0.1:8000).
# For a hosted frontend, set to the deployed Django URL, e.g. https://api.example.com
VITE_API_BASE=

# Optional basemap tile URL template (default: OpenStreetMap standard tiles), e.g.
# VITE_TILE_URL=https://{s}.basemap.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
VITE_TILE_URL=
