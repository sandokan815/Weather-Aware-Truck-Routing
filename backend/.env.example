# Copy to backend/.env and adjust. Every value is optional - defaults use free, no-key APIs.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Identify yourself to public OSM services (Nominatim/OSRM usage policy)
HTTP_USER_AGENT=TruckSafeRoutePlanner/1.0 (you@example.com)
HTTP_TIMEOUT_SECONDS=25

# Routing: osrm (default, free) | ors | mapbox | mock
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
# OpenRouteService key (free tier, truck/HGV profile): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Mapbox token (used for routing and/or geocoding when set): https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=

# Geocoding: nominatim (default) | photon | mapbox
GEOCODING_PROVIDER=nominatim
GEOCODE_COUNTRY_CODES=us,ca,mx

# Weather: open-meteo (default, free, no key) | mock (deterministic storm for demos)
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Fall back to simulated data (flagged in the response warnings) if a provider fails
ALLOW_MOCK_FALLBACK=true
